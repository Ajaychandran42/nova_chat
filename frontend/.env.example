# Local development only. Do not commit a real Clerk key to Git.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Keep these defaults when using `npm run dev` with the API at localhost:3000.
# Leave both empty for the single-service Docker/Render deployment, where the
# browser calls the same host that serves the app.
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000